# Port this proxy listens on (cPanel/Passenger usually sets PORT for you)
PORT=8080

# Where your Python backend listens
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8069

# Used to build the start command
PYTHON_BIN=/home/USERNAME/virtualenv/myapp/3.11/bin/python3
APP_FILE=/home/USERNAME/myapp/app.py
LOG_FILE=/home/USERNAME/myapp/app.log

# Optional: override the whole start command
# START_CMD=nohup /path/to/python3 /path/to/app.py > /path/to/app.log 2>&1 &

# Optional tuning (ms)
CHECK_INTERVAL=500
START_TIMEOUT=30000
